<?xml version="1.0" encoding="UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:Lyngua.Helpers"
    x:Class="Lyngua.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <helpers:InvertBoolConverter x:Key="InvertBool" />
            <helpers:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmpty" />
            <helpers:IntEqualsConverter x:Key="IntEquals" />
            <helpers:IsPositiveConverter x:Key="IsPositive" />
            <helpers:BoolToStringConverter x:Key="BoolToString" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
