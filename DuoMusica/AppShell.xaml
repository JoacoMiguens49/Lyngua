<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DuoMusica.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DuoMusica.Views"
    Shell.NavBarIsVisible="False"
    FlyoutBehavior="Disabled">

    <ShellContent
        Route="OnboardingPage"
        ContentTemplate="{DataTemplate views:OnboardingPage}" />

    <ShellContent
        Route="HomePage"
        ContentTemplate="{DataTemplate views:HomePage}" />

    <ShellContent
        Route="SongSearchPage"
        ContentTemplate="{DataTemplate views:SongSearchPage}" />

    <ShellContent
        Route="GamePage"
        ContentTemplate="{DataTemplate views:GamePage}" />

    <ShellContent
        Route="ResultsPage"
        ContentTemplate="{DataTemplate views:ResultsPage}" />

    <ShellContent
        Route="SongCompletePage"
        ContentTemplate="{DataTemplate views:SongCompletePage}" />

    <ShellContent
        Route="DeathMatchPage"
        ContentTemplate="{DataTemplate views:DeathMatchPage}" />

</Shell>
