<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Lyngua.Views.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Lyngua.ViewModels">

    <Grid BackgroundColor="{StaticResource Background}" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Song info + segment progress -->
        <StackLayout Grid.Row="0" Padding="24,60,24,16" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <StackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding Song.Name}" FontFamily="OpenSansSemibold" FontSize="18"
                           LineBreakMode="TailTruncation" TextColor="{StaticResource TextPrimary}" />
                    <Label Text="{Binding Song.Artist}" Style="{StaticResource MutedLabel}" />
                </StackLayout>
                <Label Grid.Column="1" VerticalOptions="Center" FontSize="13">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SegmentNumber}" TextColor="{StaticResource Primary}"
                                  FontFamily="OpenSansSemibold" />
                            <Span Text=" / " TextColor="{StaticResource TextMuted}" />
                            <Span Text="{Binding TotalSegments}" TextColor="{StaticResource TextMuted}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>
            <ProgressBar Progress="{Binding SessionProgress}" />
        </StackLayout>

        <!-- Playback controls -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,0,24,16">
            <StackLayout Spacing="14">
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="16">
                    <Button Text="▶  Play" Command="{Binding PlaySegmentCommand}"
                            IsEnabled="{Binding IsPlaying, Converter={StaticResource InvertBool}}"
                            BackgroundColor="{StaticResource Success}"
                            WidthRequest="140" HeightRequest="48" CornerRadius="24" FontSize="16" />
                    <Label Text="{Binding ReplaysRemaining, StringFormat='{0} replays'}"
                           Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                </StackLayout>

                <ProgressBar Progress="{Binding PlaybackProgress}" IsVisible="{Binding IsPlaying}"
                             ProgressColor="{StaticResource Success}" />
                <Label Text="{Binding PlaybackTimeLabel}" Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center" IsVisible="{Binding IsPlaying}" />

                <Label Text="Escuchá el fragmento, luego escribí lo que oíste."
                       Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
            </StackLayout>
        </Border>

        <!-- Text input -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="24,0">
            <Editor Placeholder="Escribí la letra aquí..."
                    Text="{Binding UserInput}"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="120"
                    BackgroundColor="Transparent" />
        </Border>

        <!-- Bottom bar -->
        <StackLayout Grid.Row="3" Padding="24,16" Spacing="10">
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmpty}}"
                   HorizontalTextAlignment="Center" />
            <Button Text="Enviar" Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding UserInput, Converter={StaticResource IsNotNullOrEmpty}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />
        </StackLayout>
    </Grid>
</ContentPage>
