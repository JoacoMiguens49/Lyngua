<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DuoMusica.Views.ResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DuoMusica.ViewModels"
    xmlns:controls="clr-namespace:DuoMusica.Views.Controls">

    <ScrollView BackgroundColor="{StaticResource Background}">
        <StackLayout Padding="24,60,24,32" Spacing="24">

            <!-- Score -->
            <StackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="{Binding ScoreText}" FontSize="72" FontFamily="OpenSansSemibold"
                       TextColor="{Binding ScoreColor}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding XpText}" TextColor="{StaticResource Gold}"
                       FontFamily="OpenSansSemibold" FontSize="20" HorizontalTextAlignment="Center" />
            </StackLayout>

            <!-- Diff view -->
            <Border Style="{StaticResource Card}">
                <StackLayout Spacing="10">
                    <Label Text="Tu transcripción" FontFamily="OpenSansSemibold" FontSize="16"
                           TextColor="{StaticResource TextPrimary}" />
                    <controls:DiffHighlightView DiffTokens="{Binding DiffTokens}" />
                </StackLayout>
            </Border>

            <!-- Legend -->
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20">
                <StackLayout Orientation="Horizontal" Spacing="6">
                    <BoxView Color="{StaticResource Success}" WidthRequest="12" HeightRequest="12"
                             VerticalOptions="Center" />
                    <Label Text="Correcto" Style="{StaticResource MutedLabel}" />
                </StackLayout>
                <StackLayout Orientation="Horizontal" Spacing="6">
                    <BoxView Color="{StaticResource Warning}" WidthRequest="12" HeightRequest="12"
                             VerticalOptions="Center" />
                    <Label Text="Cerca" Style="{StaticResource MutedLabel}" />
                </StackLayout>
                <StackLayout Orientation="Horizontal" Spacing="6">
                    <BoxView Color="{StaticResource Error}" WidthRequest="12" HeightRequest="12"
                             VerticalOptions="Center" />
                    <Label Text="Error" Style="{StaticResource MutedLabel}" />
                </StackLayout>
            </StackLayout>

            <!-- Actions -->
            <StackLayout Spacing="12">
                <Button Text="Siguiente segmento →" Command="{Binding NextSegmentCommand}"
                        IsVisible="{Binding IsLastSegment, Converter={StaticResource InvertBool}}" />
                <Button Text="¡Canción completa! 🎉" Command="{Binding NextSegmentCommand}"
                        IsVisible="{Binding IsLastSegment}"
                        BackgroundColor="{StaticResource Gold}" TextColor="#1E1E2E" />
                <Button Text="Repetir segmento" Command="{Binding RepeatSegmentCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>
