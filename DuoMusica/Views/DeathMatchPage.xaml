<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Lyngua.Views.DeathMatchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Lyngua.ViewModels">

    <Grid BackgroundColor="{StaticResource Background}" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="24,60,24,16" Spacing="4">
            <Label Text="⚔️ Deathmatch" Style="{StaticResource TitleLabel}" />
            <Label Text="{Binding Song.Name}" Style="{StaticResource SubtitleLabel}" />
        </StackLayout>

        <!-- Player vs Bot progress bars -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,0,24,16">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Vos" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Grid.Column="1" Text="{Binding UserProgress, StringFormat='{0:P0}'}"
                           TextColor="{StaticResource Primary}" FontFamily="OpenSansSemibold" />
                </Grid>
                <ProgressBar Grid.Row="1" Progress="{Binding UserProgress}"
                             ProgressColor="{StaticResource Primary}" />

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Bot" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Grid.Column="1" Text="{Binding BotProgress, StringFormat='{0:P0}'}"
                           TextColor="{StaticResource Secondary}" FontFamily="OpenSansSemibold" />
                </Grid>
                <ProgressBar Grid.Row="3" Progress="{Binding BotProgress}"
                             ProgressColor="{StaticResource Secondary}" />
            </Grid>
        </Border>

        <!-- Text input (active state) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="24,0"
                IsVisible="{Binding MatchEnded, Converter={StaticResource InvertBool}}">
            <StackLayout Spacing="12">
                <Label Text="{Binding StatusText}" TextColor="{StaticResource TextSecondary}"
                       FontFamily="OpenSansSemibold" />
                <Editor Placeholder="Escribí la letra aquí..."
                        Text="{Binding UserInput}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100"
                        IsEnabled="{Binding IsPlaying}"
                        BackgroundColor="Transparent" />
            </StackLayout>
        </Border>

        <!-- Match result overlay -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="24,0"
                IsVisible="{Binding MatchEnded}" BackgroundColor="{StaticResource Surface}">
            <StackLayout Spacing="16" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="{Binding UserWon, Converter={StaticResource BoolToString}, ConverterParameter='🏆 ¡Ganaste!|😢 El bot ganó'}"
                       FontSize="28" HorizontalTextAlignment="Center"
                       FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding ResultText}" Style="{StaticResource SubtitleLabel}"
                       HorizontalTextAlignment="Center" />
                <Button Text="Siguiente ronda" Command="{Binding NextRoundCommand}" />
                <Button Text="Volver al inicio" Command="{Binding GoHomeCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </StackLayout>
        </Border>

        <!-- Controls -->
        <StackLayout Grid.Row="3" Padding="24,16" Spacing="12"
                     IsVisible="{Binding MatchEnded, Converter={StaticResource InvertBool}}">
            <Button Text="▶  Escuchar" Command="{Binding PlaySegmentCommand}"
                    IsEnabled="{Binding IsPlaying, Converter={StaticResource InvertBool}}"
                    BackgroundColor="{StaticResource Success}" />
            <Button Text="Enviar" Command="{Binding SubmitCommand}"
                    IsVisible="{Binding IsPlaying}" />
        </StackLayout>

        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}" Margin="0,8" />
    </Grid>
</ContentPage>
